{
    "author": "Dennis Ek",
    "bugs": {
        "url": "https://github.com/ekdennisek/tradera-api-client/issues"
    },
    "dependencies": {
        "zod": "^3.23.8"
    },
    "description": "A Node.js module that lets you query Tradera through their API",
    "devDependencies": {
        "@types/node": "^22.5.0",
        "prettier": "^3.3.3",
        "tsx": "^4.19.0",
        "typescript": "^5.5.4"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "lib/**/*"
    ],
    "homepage": "https://github.com/ekdennisek/tradera-api-client#readme",
    "keywords": [
        "tradera"
    ],
    "license": "LGPL-3.0-only",
    "main": "lib/index.js",
    "name": "tradera-api-client",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ekdennisek/tradera-api-client.git"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf lib",
        "prepublishOnly": "npm run prettier:check && npm test && npm run clean && npm run build",
        "prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "prettier:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "node --import tsx --test test/*.test.ts",
        "test:live": "node --import tsx --test test/live/*.test.ts"
    },
    "types": "lib/index.d.ts",
    "version": "1.0.0"
}
